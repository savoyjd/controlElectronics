SYSCTL.enableROSC            = true;

UART1.$name             = "UART_0";
UART1.targetBaudRate    = 115200;
UART1.parity            = "ODD";
UART1.txPinConfig.$name = "ti_driverlib_gpio_GPIOPinGeneric8";
