SPI1.cs2PinConfig.$name  = "ti_driverlib_gpio_GPIOPinGeneric6";
SPI1.cs3PinConfig.$name  = "ti_driverlib_gpio_GPIOPinGeneric7";

SYSCTL.CANCLKSource          = "HFCLK";
SYSCTL.useHFCLK_Manual       = true;
